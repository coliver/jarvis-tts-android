root = true

[*.{kt,kts}]
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 140
# @Composable functions are conventionally PascalCase (they act like a
# component/factory, not an action) -- that's correct Compose style, not a
# naming violation.
ktlint_function_naming_ignore_when_annotated_with = Composable
